# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# lock files (yarn only - exclude other package managers)
package-lock.json
pnpm-lock.yaml
bun.lockb

# Yarn 4 Berry
.pnp.*
.yarn/cache
.yarn/install-state.gz
.yarn/build-state.yml
.yarn/unplugged

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# env files (secrets - never commit)
.env
.env.*
.env*.local

# typescript
*.tsbuildinfo

# Prettier
.prettier-cache

# generated native folders
/ios
/android
